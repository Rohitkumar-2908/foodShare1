# Vercel: set MONGODB_URI, DATA_KEY, ADMIN_EMAIL, ADMIN_PASSWORD in the project settings instead of a .env file (see docs/VERCEL.md).
# Copy to .env (never commit it). Everything has a safe default; leave MONGODB_URI empty for the local file database.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Set to 1 ONLY when running behind a reverse proxy you control (nginx). Enables X-Forwarded-* headers.
TRUST_PROXY=0

# --- Database ---
# Example: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# In Docker use MONGODB_URI_FILE=/run/secrets/mongodb_uri instead (secrets are read from files).
MONGODB_URI=mongodb+srv://new_foodshare:food2908@cluster0.pc5x2dm.mongodb.net/
MONGODB_DB=foodshare
MONGO_TIMEOUT_MS=4000
MONGO_MAX_POOL=20
MONGO_MIN_POOL=2
# secondaryPreferred sends reads to replica-set secondaries (read replicas)
MONGO_READ_PREFERENCE=primary
DATA_DIR=./data

# --- Resilience ---
BREAKER_FAILURES=3
BREAKER_COOLDOWN_MS=10000
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000

# --- Rate limiting (token bucket per client IP) ---
RATE_CAPACITY=60
RATE_REFILL_PER_SEC=1
WRITE_CAPACITY=10
WRITE_REFILL_PER_SEC=0.5
MAX_BODY_BYTES=5242880

# --- Backups, audit ---
BACKUP_INTERVAL_MIN=60
BACKUP_KEEP=14
AUDIT_TTL_DAYS=90

# --- Secrets (each also supports NAME_FILE) ---
# Bearer token required for GET /metrics. If empty, /metrics is only reachable from private addresses.
METRICS_TOKEN=
# First secret signs webhooks; list older ones after commas while rotating.
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Accounts and sessions ---
# The admin account is created from these on first start (only if no admin exists yet).
# Created on first start only. Password: 8+ characters, letters and a number, not a common password,
# and it must NOT contain the first part of the email (for admin@x.com, avoid "admin" in the password).
# If an admin already exists, these are ignored. Run `npm run admin` to create or reset the admin instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 64 hex characters (openssl rand -hex 32). Encrypts two-factor secrets at rest. If empty, a key file is created in DATA_DIR.
DATA_KEY=
SCRYPT_N=16384
SESSION_IDLE_MIN=30
SESSION_ABS_HOURS=8
LOCKOUT_ATTEMPTS=5
LOCKOUT_MS=900000
AUTH_CAPACITY=10
AUTH_REFILL_PER_SEC=0.2

# --- Feature flags: comma-separated. Add readOnly for maintenance mode (writes return 503). ---
FEATURES=webhooks,metrics
CORS_ORIGIN=
